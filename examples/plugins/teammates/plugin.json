{
  "name": "teammates",
  "version": "0.2.1",
  "title": "队友协作（Raft 式）",
  "description": "照 Raft 的协作方式：群聊里人发的每条消息都送给频道成员，不用 @，成员自己判断要不要接；工作项放在任务板上，先认领再动手，做完交待验收，人在群聊里说“#N 完成”。外部系统（如 issue）可以经回调把新需求交给“接需求”的岗位",
  "service": {
    "command": "python",
    "args": [
      "{plugin}/service/team_engine.py"
    ],
    "transport": "stdio",
    "network": false,
    "tools": {
      "tasks": "read",
      "task_create": "write",
      "task_claim": "write",
      "task_update": "write",
      "route_suggest": "hook"
    }
  },
  "hooks": {
    "route": [
      {
        "on": "message.posted",
        "tool": "route_suggest",
        "may": [
          "wake"
        ]
      }
    ]
  },
  "page_permissions": [
    "service.read"
  ],
  "tabs": [
    {
      "key": "board",
      "label": "任务板",
      "entry": "page/index.html"
    }
  ],
  "settings": [
    {
      "key": "intake",
      "label": "谁接外部来的新需求",
      "type": "role"
    }
  ],
  "triggers": [
    {
      "key": "intake",
      "type": "webhook",
      "notify": {
        "to": "{setting:intake}",
        "text": "外部来了一个新需求：{title} {url}。先建任务（task_create），再看谁接。"
      }
    }
  ]
}
