{
  "name": "dev-team",
  "version": "1.0.0",
  "title": "研发小队",
  "description": "需求分析、开发、测试三个岗位按 Raft 的方式协作：外部需求经回调交给需求分析，任务放在任务板上先认领再动手，人只验收和说“完成”",
  "params": [
    {"key": "product", "label": "产品名", "example": "协同白板", "required": true},
    {"key": "repo", "label": "代码仓库", "example": "org/whiteboard", "required": false}
  ],
  "roles": [
    {"key": "triage", "name": "需求分析", "description": "接外部来的需求：理清楚要什么、影响哪些模块、拆成任务放上任务板",
     "capabilities": ["需求分析", "拆任务"], "authority": ["web.research"]},
    {"key": "dev", "name": "开发", "description": "认领开发任务，写代码与说明，做完交待验收",
     "capabilities": ["前端", "后端", "接口"], "authority": ["file.write", "shell.exec", "connector.use"]},
    {"key": "qa", "name": "测试", "description": "认领测试任务：写用例、回归、报缺陷",
     "capabilities": ["测试用例", "回归测试"], "authority": ["file.write", "connector.use"]}
  ],
  "connectors": [
    {"slot": "code", "connector": "github", "access": "write", "roles": ["dev", "qa"],
     "purpose": "读 issue、开分支与 PR、评审"}
  ],
  "plugins": [
    {"name": "teammates", "version": "0.2.0", "source": "catalog", "settings": {"intake": "{role:triage}"}}
  ],
  "checkpoints": [
    {"at": "任务完成", "kind": "human_step", "plugin": "teammates", "note": "任务做完进“待验收”，只有人在群聊里说“#N 完成”才算完成"},
    {"at": "交付验收", "kind": "accept", "role": "dev", "note": "人交代的用户任务由下发的人验收"},
    {"at": "外部需求", "kind": "notify", "plugin": "teammates", "note": "外部回调代表启用它的人 @ 需求分析"}
  ],
  "files": ["files/开发约定.md"]
}
