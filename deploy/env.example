# 复制为 deploy/.env（chmod 600），不要提交。
# 对外站点：服务器 IP 或域名
MATRIX_SITE=your-server-ip-or-domain
# 证书：internal = 内部 CA（裸 IP 用，浏览器会警告）；acme = Let's Encrypt（MATRIX_SITE 须是域名）
# 没有域名时可以用 nip.io：MATRIX_SITE=47-88-79-27.nip.io 配 MATRIX_TLS_ISSUER=acme
MATRIX_TLS_ISSUER=internal
# basic auth：用户名与 caddy hash-password 生成的 bcrypt 哈希。哈希里的每个 $ 写成 $$（compose 会插值 $）
# 写 off 关掉 basic auth（这时 MATRIX_BASIC_HASH 不用填）：只剩 Matrix 自己的简易登录，不安全，只用于临时演示
MATRIX_BASIC_AUTH=on
MATRIX_BASIC_USER=matrix
MATRIX_BASIC_HASH=
# DSH 模型凭据（也可以进容器用 dsh 自己的方式配置）
# DEEPSEEK_API_KEY=
# 抓取白名单：默认读数据卷里的 /data/fetch.json（见 README「内网抓取白名单」），放别处时写路径
# MATRIX_FETCH=/data/fetch.json
# 管理后台（/admin，看整个网络的使用情况）给谁看：邮箱，逗号分隔；不填 = 最早注册的那个人
# MATRIX_ADMINS=you@example.com
# 企业内部 IM 的驱动包（pip 安装参数，空格隔开；改了要 docker compose up -d --build），见 docs/im-driver-authoring.md
# MATRIX_IM_DRIVERS=acme-im==1.2.0
# 驱动要的地址等也写在这里，例如私有化部署的企业微信：
# MATRIX_WECOM_URL=wss://openws.corp.example
# 无公网构建（改了要 docker compose up -d --build），见 README「内网 / 无公网构建」。都空着 = 官方源
# MATRIX_APT_MIRROR=http://mirror.corp.example          # 其下有 debian、debian-security
# MATRIX_NPM_REGISTRY=http://npm.corp.example/
# MATRIX_PYPI_INDEX=http://pypi.corp.example/simple
# MATRIX_NODE_TARBALL=http://mirror.corp.example/nodejs/latest-v24.x/node-v24.21.0-linux-x64.tar.xz
