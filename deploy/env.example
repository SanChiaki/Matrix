# 复制为 deploy/.env（chmod 600），不要提交。
# 对外站点：服务器 IP 或域名
MATRIX_SITE=your-server-ip-or-domain
# basic auth：用户名与 caddy hash-password 生成的 bcrypt 哈希。哈希里的每个 $ 写成 $$（compose 会插值 $）
# 写 off 关掉 basic auth：只剩 Matrix 自己的简易登录，不安全，只用于临时演示
MATRIX_BASIC_AUTH=on
MATRIX_BASIC_USER=matrix
MATRIX_BASIC_HASH=
# DSH 模型凭据（也可以进容器用 dsh 自己的方式配置）
# DEEPSEEK_API_KEY=
