# 唯一对外入口。证书签发方由 MATRIX_TLS_ISSUER 决定：
# - internal（默认）：Caddy 自己的内部 CA，适合裸 IP（浏览器会提示不受信任）；
# - acme：Let's Encrypt 正式证书，MATRIX_SITE 必须是能从公网解析到本机的域名（例如 47-88-79-27.nip.io），
#   且 80 / 443 对外开放。不需要邮箱。
{
	# 按 IP 访问时客户端不发 SNI，Caddy 需要知道默认用哪张证书
	default_sni {$MATRIX_SITE}
}

# Matrix 自己的登录很简陋（无 CSRF、无限流、令牌不过期），前面再加一层 basic auth。
# 片段只在被 import 时才解析：MATRIX_BASIC_AUTH=off 时不需要 MATRIX_BASIC_HASH
# （只剩 Matrix 自己的登录，不安全，只用于临时演示）。
(basic-auth-on) {
	basic_auth {
		{$MATRIX_BASIC_USER:matrix} {$MATRIX_BASIC_HASH}
	}
}
(basic-auth-off) {
}

{$MATRIX_SITE} {
	# 显式写 tls：default_sni 才会生成“空 SNI 也用这张证书”的连接策略
	tls {
		issuer {$MATRIX_TLS_ISSUER:internal}
	}

	# 按 MATRIX_BASIC_AUTH 选上面的片段；写错（不是 on / off）时 Caddy 起不来，不会悄悄放开
	import basic-auth-{$MATRIX_BASIC_AUTH:on}

	# /internal/* 只给容器里的 dsh / MCP 回调用（走 127.0.0.1），不对外
	@internal path /internal/*
	respond @internal 404

	# 端侧连接器：/api/devices/connect 是 WebSocket（升级由 reverse_proxy 自动处理），
	# 令牌走 query，鉴权由应用自己做；这里不需要额外放行。

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy matrix:8765 {
		# SSE（/api/events）不缓冲
		flush_interval -1
	}
}

# 其它 Host（例如 127.0.0.1、别的域名）：不转给 Matrix
:443 {
	tls internal
	respond 404
}
