{
  "namespace": "matrix",
  "image": "matrix-sandbox:local",
  "runtime": "runsc",
  "gateway_container": "matrix-core",
  "connect_url": "ws://{gateway}:8766/api/sandbox/connect",
  "subnet_pool": "10.213.0.0/16",
  "workdir_prefixes": ["/data/conversations/", "/data/tasks/"],
  "cpus": 2,
  "host_reserve_mb": 1024,
  "pids": 512,
  "tmp_mb": 512,
  "env": {}
}
